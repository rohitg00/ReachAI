# iii project Dockerfile — generated by `iii project generate-docker`, adapted for ReachAI.
# Base image is distroless + non-root; edit freely, the generator won't overwrite.
#
# Pinned rather than `latest` so a new engine release cannot change what a
# rebuild ships. The alpha channel (which carries `iii compose`) publishes no
# image, so the container runs the stable engine and reads config.yaml; see
# README.md under "Forward compatibility".
FROM iiidev/iii:0.22.1

ENV III_EXECUTION_CONTEXT=docker

WORKDIR /app
COPY config.yaml /app/config.yaml

# The worker source. config.yaml points `reachai-backend` at this directory, and
# the engine runs the manifest's `install` script on first boot (that step needs
# network to fetch `iii-sdk`). The base image is distroless, so there is no shell
# or Node here to pre-install it at build time.
COPY . /app/reachai-backend

EXPOSE 49134 3111 3112 9464
ENTRYPOINT ["/app/iii"]
CMD ["--config", "/app/config.yaml"]
